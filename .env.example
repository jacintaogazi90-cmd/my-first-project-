# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
# Nothing here except NEXT_PUBLIC_* ever reaches the browser.

# The production origin. Used for canonical URLs, Open Graph images and sitemap.
NEXT_PUBLIC_SITE_URL=https://ekolumiere.com

# --- Enquiry form (Resend) -------------------------------------------------
# https://resend.com/api-keys — server-side only.
RESEND_API_KEY=
# Where enquiries land. Defaults to hotel.email in src/lib/hotel.ts.
ENQUIRY_TO_EMAIL=reservations@ekolumiere.com
# Must be an address on a domain verified in Resend, or delivery fails.
ENQUIRY_FROM_EMAIL=website@ekolumiere.com

# --- Payments (Phase 4) ----------------------------------------------------
# Test keys until the hotel has completed CAC/business verification with each
# provider. Only the PUBLIC keys may be exposed to the browser.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxxxx
